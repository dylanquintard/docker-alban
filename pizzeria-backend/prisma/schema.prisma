model UserPositionAssignment {
  id            Int           @id @default(autoincrement())
  tenantId      Int
  userId        Int
  positionId    Int
  active        Boolean       @default(true)
  isResponsible Boolean       @default(false)
  startedAt     DateTime      @default(now())
  endedAt       DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  StockPosition StockPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  Tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  User          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, positionId])
  @@index([tenantId, positionId, active])
  @@index([tenantId, userId, active])
}

model ZoneItemAssignment {
  id        Int       @id @default(autoincrement())
  tenantId  Int
  zoneId    Int
  itemId    Int
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime
  StockItem StockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  Tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  StockZone StockZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, itemId])
  @@index([tenantId, itemId, active])
  @@index([tenantId, zoneId, active])
}


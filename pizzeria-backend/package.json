{
  "name": "pizzeria-backend",
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "lint": "node --check src/server.js && node --check src/worker.js && node --check src/middlewares/rate-limit.js",
    "test": "node --require ./tests/setup-env.js --test",
    "test:coverage": "node --require ./tests/setup-env.js --test --experimental-test-coverage",
    "smoke:local": "node scripts/smoke-health.js",
    "build": "npm run prisma:generate",
    "smoke:live": "node scripts/live-api-smoke.js",
    "smoke:mail": "node scripts/smoke-mail.js",
    "smoke:mono": "node scripts/mono-camion-smoke.js",
    "seed:mono": "node scripts/seed-mono-camion.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "render-build": "npm run prisma:generate && npm run prisma:migrate:deploy"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.6",
    "png-to-ico": "^3.0.1",
    "prisma": "^5.22.0",
    "redis": "^5.9.0",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
